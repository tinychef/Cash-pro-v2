# Cash Pro API environment

# Standard PostgreSQL connection string (Supabase / Cloud SQL / RDS / Neon / local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashpro

# Clerk (leave unset for local dev to use the x-company-id header fallback)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Dev-only tenant fallback when Clerk is not configured
DEV_COMPANY_ID=

# CORS: comma-separated list of allowed web origins
WEB_ORIGIN=http://localhost:3000

PORT=8080

# ---- Email (Resend) — optional; enables /send + /remind-overdue ----
RESEND_API_KEY=
EMAIL_FROM="Mi Negocio <facturas@midominio.com>"
PUBLIC_WEB_URL=
APP_SECRET=
