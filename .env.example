# ============================================================
# Cash Pro v2 — local dev environment (root)
# Copy to `.env` (the dev:up script does this automatically) and edit.
# `scripts/dev-up.sh` loads this file and exports every variable so you
# never have to inline DATABASE_URL on each command.
# ============================================================

# Standard PostgreSQL connection string (Supabase / Cloud SQL / RDS / Neon / local).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashpro

# Web → API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# API CORS allowlist (comma-separated web origins).
WEB_ORIGIN=http://localhost:3000

# API port.
PORT=8080

# ---- Authentication (Clerk) — OPTIONAL ----
# Leave UNSET for local dev: the app runs in dev mode and auto-creates a demo
# company (POST /dev/bootstrap). Set BOTH to enable real multi-user/multi-tenant.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Email (Resend) — OPTIONAL ----
# Set to enable "enviar factura por email" + recordatorios de vencimiento.
RESEND_API_KEY=
EMAIL_FROM="Mi Negocio <facturas@midominio.com>"
# Base URL used inside emails for the public invoice links (defaults to WEB_ORIGIN).
PUBLIC_WEB_URL=
# Secret for signing public share tokens (defaults to CLERK_SECRET_KEY in prod).
APP_SECRET=
